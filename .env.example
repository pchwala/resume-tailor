# Copy to .env and fill in. Loaded by django-environ in config/settings.py.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
# Local defaults below. On Cloud Run leave these unset (settings defaults to `.run.app` /
# `https://*.run.app`) or set explicitly, e.g. ALLOWED_HOSTS=.run.app and
# CSRF_TRUSTED_ORIGINS=https://*.run.app. Set DEBUG=False in production.
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Required — Neon POOLED connection string (host has `-pooler`, sslmode=require). No SQLite
# fallback. settings.py disables psycopg3 prepared statements + server-side cursors for the
# pooled endpoint; if you use the DIRECT (non-pooled) host instead, those options are harmless.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require

# OpenAI — used by tailoring/ai.py (gpt-4.1)
OPENAI_API_KEY=sk-...
